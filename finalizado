<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atividade Cafeteria</title>
</head>
<body>
    
    <style>
        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        list-style: none;
        text-decoration: none;
        border: none;
        font-family: 'Times New Roman', Times, serif
       
      }

      body {
        background-color:rgb(249, 214, 39);
      }

       main section.pg1, main section.pg2, main section.pg3, main section.pg4 {
        padding: 5vw 10vw 5vw 10vw;
        color: white;
        text-align: center;
        display: none;
       }

         main section.pg1 button, main section.pg2 button, main section.pg3 button, main section.pg4 button{
            background-color: green;
            border-radius: 15px;
            color: white;
            padding: 2vw 4vw 2vw 4vw;
            border: 1px solid black;
            margin: 4vw 0 0 0;
            font-size: 1.8rem;
        }

        main section.pg1 {
            display: block;
        }

        main section.pg1 h1 {
            font-size: 2.5rem;
            margin: 2.5vw 0 2.5vw 0;
        }

        main section.pg1 p {
            margin: 2.5vw 0 2.5vw 0;
            font-size: 3rem;
        }

          main section.pg1 span, section.pg2 span, section.pg3 span, section.pg4 span {
            color: rgb(225, 118, 18);
            font-weight: bold;
            font-size: 3rem;
          }

         main section.pg1 img {
            margin: 0 0 2.5vw 0;
            max-width: 50%;

         }

         main section.pg2 ul {
            display: grid;
            max-width: 50%;
            margin: 0 auto;
        
           
         }
    

         main section.pg2 select, main section.pg3 select {
            border-radius: 15px;
            padding: 1vw 2vw 1vw 2vw;
            border: 1px solid black;
            margin: 0 2.5vw 0 0;
         }

          main section.pg2 h2, main section.pg3 h2, main section.pg4 h2 {
            margin: 0 0 3vw 0;
         }

         main section.pg2 ul, main section.pg3 ul {
            display: grid;
            grid-template-columns: 1fr 1fr;
            margin: 3vw auto 3vw auto ;
            gap: 100px;
            width: fit-content;

          }

         main section.pg2 ul li h2, main section.pg3 ul li h2 {
            margin: 2vw 0 2vw 0;
         }

         main section.pg2 ul li img , main section.pg3 ul li img {
            max-width: 300px;
         }


         main section.pg4 p {
            font-size: 2rem;
         }

         main section.pg4 h2 {
            font-weight: bold;
         }

         

         @media (max-width: 720px) {

            body {
                font-size: 1.2rem;
            }
         
            main section.pg2 ul, main section.pg3 ul {
              display: inline;
              padding: 2vw 2vw 2vw 2vw; 
            } 

            main section.pg2 ul li img, main section.pg3 ul li img {
                margin: 0 0 1vw 0;
                max-width: 80vw;
            }
         }

    </style>




    <main>
        <section class="pg1">
            <h1>Bem-vindo ao <span>Café</span> na Veia!</h1>
            <p>Seu lugar favorito para <span>cafés.</span></p>
           <div>
             <img src="imagens-Café/xicara-de-cafe.png" alt="Logo Café">
           </div>
            <button type="button" id="irmenu">Menu</button>
        </section>

        <section class="pg2">
            <h2>Por Favor, escolha seu <span>Cafezinho!</span></h2>
            <form action="">
           <select name="cafes" id="cafes">

            <option value="Café Preto">Café Preto</option>
            <option value="Cappuccino">Cappuccino</option>
            <option value="Caramelo">Caramelo</option>
            <option value="Moca">Moca</option>
            <option value="Expresso">Expresso</option>

        </select>
        <button type="button" id="confirmar">Selecionar</button>
        </form>

        <ul>
                    <li>
                        <h2>Café Preto</h2>
                        <img src="imagens-Café/Café Preto.jpg" alt="Café Preto">
                    </li>

                    <li>
                        <h2>Cappuccino</h2>
                        <img src="imagens-Café/receita-cappuccino-caseiro.jpg" alt="Cappuccino">
                    </li>

                    <li>
                        <h2>Caramelo</h2>
                        <img src="imagens-Café/Café caramelo.jpg" alt="Caramelo">
                    </li>

                    <li>
                        <h2>Moca</h2>
                        <img src="imagens-Café/café moca.jpg" alt="Moca">
                    </li>

                    <li>
                        <h2>Expresso</h2>
                        <img src="imagens-Café/café-expresso.png" alt="Expresso">
                    </li>
                </ul>

        </section>

        <section class="pg3">
            <h2>Agora, Escolha sua <span>Porção</span> predileta para dar um gosto a mais!</h2>
            <form action="">

                <select name="porcao" id="porcoes">
                    
                    <option value="Pão de Queijo">Pão de Queijo</option>
                    <option value="Bolo">Bolo</option>
                    <option value="Chocolate">Chocolate</option>
                    <option value="Biscoito">Biscoito</option>
                    <option value="Crepe">Crepe</option>
                    
                </select>
                    <button type="button" id="confirmar2">Selecionar</button>                
            </form> 
            <ul>
                <li>
                    <h2>Pão de Queijo</h2>
                    <img src="Imagens-Porções/pao-de-queijo_receita.jpg" alt="Pão de Queijo">
                </li>

                <li>
                    <h2>Bolo</h2>
                    <img src="Imagens-Porções/Bolo.jpg" alt="Bolo">
                </li>

                <li>
                    <h2>Chocolate</h2>
                    <img src="Imagens-Porções/chocolate.jpg" alt="Chocolate">
                </li>

                <li>
                    <h2>Biscoito</h2>
                    <img src="Imagens-Porções/Biscoito.jpg" alt="Biscoito">
                </li>

                <li>
                    <h2>Crepe</h2>
                    <img src="Imagens-Porções/Crepe.png" alt="Crepe">
                </li>
            </ul>           
        </section>

        <section class="pg4">
            <h2>Seu <span>Pedido</span> foi realizado!</h2>
            <p id="resultado"></p>
            <img src="#" alt="">
            <p><span>Obrigado!</span></p>
            <button type="button" id="retornar">Retornar a página inicial.</button>

        </section>

    </main>

    <script>

        let cafe = document.querySelector('#cafes');
        let confirmar = document.querySelector('#confirmar');
        let porcao = document.querySelector('#porcoes')
        let confirmar2 = document.querySelector('#confirmar2')
        let resultado = document.querySelector('#resultado')
        let escolhacafe = ""
        let escolhaporcao = ""
        let retornar = document.getElementById('retornar')
       
 
        function passar(atual, proxima) {
    document.querySelector(atual).style.display = 'none';
    document.querySelector(proxima).style.display = 'block';
}

       let irmenu = document.querySelector('#irmenu')
       irmenu.addEventListener('click', () => {
        passar('.pg1', '.pg2');
       })

        confirmar.addEventListener('click', () => {
        escolhacafe = cafe.value;
        passar('.pg2', '.pg3')
        })

        confirmar2.addEventListener('click', () => {
        escolhaporcao = porcao.value;
        passar('.pg3', '.pg4')
    
        resultado.innerHTML = `${escolhacafe} e ${escolhaporcao}.`;
        })

        retornar.addEventListener('click', () => {
            passar('.pg4', '.pg1')
        })        

       

   </script>
</body>

</html>
